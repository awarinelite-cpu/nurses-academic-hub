# Copy this file to .env for local development (already gitignored),
# or set these same names in Vercel → Project → Settings →
# Environment Variables for production.
#
# Get the values from: Firebase Console → Project settings → General
# → "Your apps" → the web app's config object.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
